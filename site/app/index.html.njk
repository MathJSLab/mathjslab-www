---json
{
  "lang": "en",
  "rootEndpoint": true,
  "robotsFollow": true,
  "permalink": "/app/index.html",
  "main": {
    "title": "MathJSLab apps",
    "description": "Choose a language for the MathJSLab app hub."
  }
}
---
{%- from 'includes/head-macros.njk' import headBegin, headOpenGraph, headTwitter, headAlternate, headIcon -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
{{ headBegin(main.title, main.description, pkg.author, pkg.keywords.join()) }}
{{ headOpenGraph(i18n = false, lang = 'en', title = main.title, description = main.description, url = site.url, name = site.title, image = '/images/mathjslab-og.png', pageUrl = site.url + '/en/app/') }}
{{ headTwitter(main.title, main.description, site.url, '/images/mathjslab-og.png', site.title) }}
{{ headAlternate(i18n, url = site.url, postfix = 'app/') }}
{{ headIcon(light = '/images/favicon.ico', dark = '/images/favicon-dark.ico', svg = '/images/mathjslab-logo.svg') }}
    <link rel="stylesheet" href="/css/main.css">
    <script>
      (() => {
        const supportedLocales = new Set(['en', 'es', 'pt']);
        const locale = (navigator.language || 'en').toLowerCase().substring(0, 2);
        window.location.replace(`/${supportedLocales.has(locale) ? locale : 'en'}/app/`);
      })();
    </script>
  </head>
  <body class="language-gateway">
    <main class="gateway-panel">
      <img src="/images/mathjslab-logo.svg" alt="MathJSLab" width="94" height="94">
      <h1>MathJSLab</h1>
      <p>Choose your language.</p>
      <nav class="gateway-links" aria-label="Language">
        <a href="/en/app/">English</a>
        <a href="/pt/app/">Português</a>
        <a href="/es/app/">Español</a>
      </nav>
    </main>
  </body>
</html>
