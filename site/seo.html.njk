---
{%- from 'includes/head-macros.njk' import headBegin, headIcon -%}
<!DOCTYPE html>
<html lang="en">
  <head>
{{ headBegin(main.title, main.description, pkg.author, pkg.keywords.join(), 'noindex,nofollow') }}
{{ headIcon(light = '/images/favicon.ico', dark = '/images/favicon-dark.ico', svg = '/images/mathjslab-logo.svg') }}
    <style>
      :root {
        color-scheme: light dark;
        --background: #f8fbf8;
        --surface: rgba(255, 255, 255, 0.82);
        --surface-strong: #ffffff;
        --border: rgba(23, 111, 59, 0.16);
        --text: #172019;
        --muted: #58655d;
        --accent: #176f3b;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --background: #101712;
          --surface: rgba(24, 35, 28, 0.84);
          --surface-strong: #18231c;
          --border: rgba(129, 209, 164, 0.24);
          --text: #edf7ef;
          --muted: #b5c4ba;
          --accent: #81d1a4;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-width: 320px;
        margin: 0;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(92, 170, 92, 0.18), transparent 34rem),
          var(--background);
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .seo-shell {
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
        padding: 2rem 0 4rem;
      }

      .seo-header {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 2rem;
      }

      .seo-header img {
        width: 4rem;
        height: 4rem;
      }

      h1,
      h2,
      p {
        margin-top: 0;
      }

      h1 {
        margin-bottom: 0.25rem;
        font-size: clamp(2rem, 6vw, 3.4rem);
        line-height: 1.05;
      }

      .seo-header p {
        margin-bottom: 0;
        color: var(--muted);
        font-size: 1.05rem;
      }

      .tool-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        counter-reset: tools;
      }

      .tool-card {
        counter-increment: tools;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
        background: var(--surface);
      }

      .tool-card h2 {
        display: flex;
        gap: 0.5rem;
        align-items: baseline;
        margin-bottom: 0.35rem;
        font-size: 1.15rem;
        line-height: 1.3;
      }

      .tool-card h2::before {
        color: var(--muted);
        content: counter(tools) ".";
        font-variant-numeric: tabular-nums;
      }

      .tool-card p {
        margin-bottom: 0.75rem;
        color: var(--muted);
      }

      .tool-links {
        display: grid;
        gap: 0.35rem;
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .tool-links a {
        display: block;
        overflow-wrap: anywhere;
        border-radius: 6px;
        padding: 0.4rem 0.5rem;
        background: var(--surface-strong);
      }

      @media (max-width: 760px) {
        .seo-shell {
          width: min(100% - 1rem, 1120px);
          padding-top: 1rem;
        }

        .seo-header {
          align-items: flex-start;
        }

        .seo-header img {
          width: 3rem;
          height: 3rem;
        }

        .tool-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main class="seo-shell">
      <header class="seo-header">
        <img src="/images/mathjslab-logo.svg" alt="" width="64" height="64">
        <div>
          <h1>{{ main.title }}</h1>
          <p>{{ main.description }}</p>
        </div>
      </header>

      <div class="tool-grid">
        {% for tool in tools %}
          <section class="tool-card">
            <h2><a href="{{ tool.href }}" target="_blank" rel="noopener noreferrer">{{ tool.name }}</a></h2>
            <p>{{ tool.description }}</p>
            {% if tool.links or tool.urlPrefix %}
              <ul class="tool-links">
                {% if tool.links %}
                  {% for link in tool.links %}
                    <li><a href="{{ link.href }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a></li>
                  {% endfor %}
                {% else %}
                  {% for endpoint in endpoints %}
                    <li><a href="{{ tool.urlPrefix }}{{ endpoint.encoded }}" target="_blank" rel="noopener noreferrer">{{ endpoint.label }}</a></li>
                  {% endfor %}
                {% endif %}
              </ul>
            {% endif %}
          </section>
        {% endfor %}
      </div>
    </main>
  </body>
</html>
