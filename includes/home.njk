{% set pageData = i18n.pages[lang] %}
<section id="overview" class="hero section-shell">
  <div class="hero-copy">
    <p class="eyebrow">{{ pageData.hero.kicker }}</p>
    <h1>{{ pageData.hero.heading }}</h1>
    <p class="hero-lead">{% if pageData.hero.leadHtml %}{{ pageData.hero.leadHtml | safe }}{% else %}{{ pageData.hero.lead }}{% endif %}</p>
    <div class="hero-actions" aria-label="{{ pageData.resourcesTitle }}">
      <a class="button button-primary" href="/{{ lang }}/app/" target="_blank" rel="noopener noreferrer">{% if pageData.hero.primaryCtaHtml %}{{ pageData.hero.primaryCtaHtml | safe }}{% else %}{{ pageData.hero.primaryCta }}{% endif %}</a>
      <a class="button button-secondary" href="https://github.com/MathJSLab" target="_blank" rel="noopener noreferrer">
        <img class="button-icon" src="/img/Octicons-mark-github.svg" alt="">
        <span>{{ pageData.hero.secondaryCta }}</span>
      </a>
    </div>
    <div class="install-command" aria-label="{{ pageData.hero.installLabel }}">
      <span>
        <img src="/img/Npm-logo.svg" alt="">
        {{ pageData.hero.installLabel }}
      </span>
      <code>npm install mathjslab</code>
    </div>
  </div>
  <div class="hero-panel" aria-label="{{ pageData.hero.terminalTitle }}">
    <div class="terminal-bar">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="terminal-session">
      <div class="terminal-line terminal-prompt"><code>&gt;&gt; {{ pageData.hero.promptOne }}</code></div>
      <div class="terminal-line terminal-output">{{ pageData.hero.outputOneMathML | safe }}</div>
      <div class="terminal-line terminal-prompt"><code>&gt;&gt; {{ pageData.hero.promptTwo }}</code></div>
      <div class="terminal-line terminal-output">{{ pageData.hero.outputTwoMathML | safe }}</div>
      <div class="terminal-line terminal-prompt"><code>&gt;&gt; {{ pageData.hero.promptThree }}</code></div>
      <div class="terminal-line terminal-output">{{ pageData.hero.outputThreeMathML | safe }}</div>
    </div>
  </div>
</section>

<section id="pipeline" class="section-shell pipeline-section">
  <div class="section-heading">
    <p class="eyebrow">{{ pageData.pipeline.kicker }}</p>
    <h2>{{ pageData.pipeline.title }}</h2>
    <p>{% if pageData.pipeline.leadHtml %}{{ pageData.pipeline.leadHtml | safe }}{% else %}{{ pageData.pipeline.lead }}{% endif %}</p>
  </div>
  <figure class="pipeline-figure">
    <img src="{{ pageData.pipeline.image }}" alt="{{ pageData.pipeline.imageAlt }}" width="1672" height="941" loading="lazy">
  </figure>
  <div class="pipeline-mobile-carousel" data-pipeline-carousel>
    <button class="pipeline-carousel-open" type="button" aria-label="{{ pageData.pipeline.carouselOpenLabel }}">
      <img src="{{ pageData.pipeline.carouselThumb }}" alt="{{ pageData.pipeline.imageAlt }}" loading="lazy">
    </button>
    <div class="pipeline-carousel-overlay" aria-hidden="true">
      <div class="pipeline-carousel-panel" role="dialog" aria-modal="true" aria-label="{{ pageData.pipeline.title }}">
        <div class="pipeline-carousel-stage">
          {% for panel in pageData.pipeline.carouselPanels %}
            <img class="pipeline-carousel-image{% if loop.first %} is-active{% endif %}" src="{{ panel }}" alt="{{ pageData.pipeline.imageAlt }}" loading="lazy" data-carousel-panel="{{ loop.index0 }}">
          {% endfor %}
        </div>
        <div class="pipeline-carousel-indicators" aria-hidden="true">
          {% for panel in pageData.pipeline.carouselPanels %}
            <span{% if loop.first %} class="is-active"{% endif %}>→</span>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<section id="features" class="section-shell">
  <div class="section-heading">
    <p class="eyebrow">{{ pageData.nav.features }}</p>
    <h2>{% if pageData.descriptionHtml %}{{ pageData.descriptionHtml | safe }}{% else %}{{ pageData.description }}{% endif %}</h2>
  </div>
  <div class="feature-grid">
    {% for item in pageData.highlights %}
      <article class="feature-card">
        <h3>{{ item.title }}</h3>
        <p>{% if item.textHtml %}{{ item.textHtml | safe }}{% else %}{{ item.text }}{% endif %}</p>
      </article>
    {% endfor %}
  </div>
</section>

<section id="ecosystem" class="section-shell split-section">
  <div class="section-heading">
    <p class="eyebrow">{{ pageData.nav.ecosystem }}</p>
    <h2>{{ pageData.ecosystemTitle }}</h2>
    <p>{% if pageData.ecosystemLeadHtml %}{{ pageData.ecosystemLeadHtml | safe }}{% else %}{{ pageData.ecosystemLead }}{% endif %}</p>
  </div>
  <div class="repo-list">
    {% for repo in pageData.repositories %}
      <a class="repo-card" href="{{ repo.href }}" target="_blank" rel="noopener noreferrer">
        <span>
          {% if repo.icon %}
            <img src="{{ repo.icon }}" alt="">
          {% endif %}
          {{ repo.role }}
        </span>
        <strong>{{ repo.name }}</strong>
        <p>{% if repo.textHtml %}{{ repo.textHtml | safe }}{% else %}{{ repo.text }}{% endif %}</p>
      </a>
    {% endfor %}
  </div>
</section>

<section id="publication" class="section-shell publication-section">
  <div class="section-heading">
    <p class="eyebrow">{{ pageData.nav.publication }}</p>
    <h2>{{ pageData.publicationTitle }}</h2>
    <p>{% if pageData.publicationLeadHtml %}{{ pageData.publicationLeadHtml | safe }}{% else %}{{ pageData.publicationLead }}{% endif %}</p>
  </div>
  <p class="publication-intro">{% if pageData.publicationTextHtml %}{{ pageData.publicationTextHtml | safe }}{% else %}{{ pageData.publicationText }}{% endif %}</p>
  <div class="publication-grid">
    {% for item in pageData.publications %}
      <article class="publication-card">
        <div>
          <span>
            {% if item.roleHtml %}
              {{ item.roleHtml | safe }}
            {% else %}
              {% if item.icon %}
                <img src="{{ item.icon }}" alt="">
              {% endif %}
              {{ item.role }}
            {% endif %}
          </span>
          <h3><a href="{{ item.href }}" target="_blank" rel="noopener noreferrer">{{ item.name }}</a></h3>
        <p>{% if item.textHtml %}{{ item.textHtml | safe }}{% else %}{{ item.text }}{% endif %}</p>
        </div>
        <div class="badge-list" aria-label="{{ item.name }} badges">
          {% for badge in item.badges %}
            <a href="{{ badge.href }}" target="_blank" rel="noopener noreferrer">
              <img src="{{ badge.src }}" alt="{{ badge.alt }}">
            </a>
          {% endfor %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<section id="archive" class="section-shell archive-section">
  <div class="section-heading">
    <p class="eyebrow">{{ pageData.nav.archive }}</p>
    <h2>{{ pageData.archiveTitle }}</h2>
    <p>{% if pageData.archiveLeadHtml %}{{ pageData.archiveLeadHtml | safe }}{% else %}{{ pageData.archiveLead }}{% endif %}</p>
  </div>
  <div class="archive-list">
    {% for item in pageData.archiveItems %}
      <a class="archive-card" href="{{ item.href }}" target="_blank" rel="noopener noreferrer">
        <span>{{ item.language }} · {{ item.file }}</span>
        <strong>{% if item.titleHtml %}{{ item.titleHtml | safe }}{% else %}{{ item.title }}{% endif %}</strong>
        <p>{% if item.descriptionHtml %}{{ item.descriptionHtml | safe }}{% else %}{{ item.description }}{% endif %}</p>
        <small>{{ item.date }}</small>
      </a>
    {% endfor %}
  </div>
</section>

<section id="resources" class="section-shell resources-section">
  <div class="section-heading">
    <p class="eyebrow">{{ pageData.nav.resources }}</p>
    <h2>{{ pageData.resourcesTitle }}</h2>
    <p>{% if pageData.resourcesLeadHtml %}{{ pageData.resourcesLeadHtml | safe }}{% else %}{{ pageData.resourcesLead }}{% endif %}</p>
  </div>
  <div class="resource-links">
    {% for resource in pageData.resources %}
      <a href="{{ resource.href }}" target="_blank" rel="noopener noreferrer">
        {% if resource.labelHtml %}
          <span>{{ resource.labelHtml | safe }}</span>
        {% else %}
          {% if resource.icon %}
            <img src="{{ resource.icon }}" alt="">
          {% endif %}
          <span>{{ resource.label }}</span>
        {% endif %}
      </a>
    {% endfor %}
  </div>
  <div class="notice-grid">
    <p>{% if pageData.notices.educationHtml %}{{ pageData.notices.educationHtml | safe }}{% else %}{{ pageData.notices.education }}{% endif %}</p>
    <p>{% if pageData.notices.trademarkHtml %}{{ pageData.notices.trademarkHtml | safe }}{% else %}{{ pageData.notices.trademark }}{% endif %}</p>
  </div>
</section>

<section id="contact" class="section-shell contact-section">
  <div class="section-heading">
    <p class="eyebrow">{{ pageData.nav.contact }}</p>
    <h2>{{ pageData.contactTitle }}</h2>
    <p>{% if pageData.contactLeadHtml %}{{ pageData.contactLeadHtml | safe }}{% else %}{{ pageData.contactLead }}{% endif %}</p>
  </div>
  <a class="contact-card" href="mailto:{{ pageData.notices.contactEmail }}">
    <img src="/img/mathjslab-logo.svg" alt="" width="48" height="48">
    <span>{{ pageData.notices.contactEmail }}</span>
  </a>
</section>

<section id="license" class="section-shell license-section">
  <div class="section-heading">
    <p class="eyebrow">{{ pageData.nav.license }}</p>
    <h2>{{ pageData.licenseTitle }}</h2>
    <p>{% if pageData.licenseLeadPrefixHtml %}{{ pageData.licenseLeadPrefixHtml | safe }}{% else %}{{ pageData.licenseLeadPrefix }}{% endif %}<a href="{{ pageData.licenseHref }}" target="_blank" rel="noopener noreferrer">{{ pageData.licenseLinkLabel }}</a>{{ pageData.licenseLeadSuffix }}</p>
  </div>
  <div class="license-panel">
    <div class="license-branding" aria-hidden="true">
      <img src="/img/MIT_Logo_New.svg" alt="">
    </div>
    <pre><code>{{ pageData.licenseText }}</code></pre>
  </div>
</section>
