{%- from 'includes/head-macros.njk' import headBegin, headOpenGraph, headTwitter, headAlternate, headIcon -%}
{%- set pageData = i18n.pages[lang] -%}
{%- set main = pageData -%}
<!DOCTYPE html>
<html lang="{{ pageData.htmlLang }}">
  <head>
{{ headBegin(main.title, main.description, pkg.author, pkg.keywords.join()) }}
{{ headOpenGraph(i18n, lang, main.title, main.description, site.url, site.title, '/images/mathjslab-og.png', pageUrl = site.url + '/' + lang + '/') }}
{{ headTwitter(main.title, main.description, site.url, '/images/mathjslab-og.png', site.title) }}
{%- include "site-json-ld.njk" -%}
{{ headAlternate(i18n, lang, site.url) }}
{{ headIcon(light = '/images/favicon.ico', dark = '/images/favicon-dark.ico', svg = '/images/mathjslab-logo.svg') }}
    <link rel="stylesheet" href="/css/main.css">
    <script type="module" src="/js/components.js"></script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/{{ lang }}/" aria-label="MathJSLab">
        <img src="/images/mathjslab-logo.svg" alt="" width="121" height="121">
        <span><strong>MathJSLab</strong></span>
      </a>
      <div id="site-menu" class="site-menu">
        <nav class="main-nav" aria-label="{{ pageData.nav.mainNavLabel }}">
          <a href="#overview">{{ pageData.nav.overview }}</a>
          <a href="#pipeline">{{ pageData.nav.pipeline }}</a>
          <a href="#features">{{ pageData.nav.features }}</a>
          <a href="#markdown">{{ pageData.nav.markdown }}</a>
          <a href="#ecosystem">{{ pageData.nav.ecosystem }}</a>
          <a href="#publication">{{ pageData.nav.publication }}</a>
          <a href="#resources">{{ pageData.nav.resources }}</a>
          <a href="#contact">{{ pageData.nav.contact }}</a>
          <a href="#license">{{ pageData.nav.license }}</a>
        </nav>
      </div>
      <div class="header-actions">
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
          <span class="menu-toggle-icon" aria-hidden="true"></span>
          <span>{{ pageData.nav.menu }}</span>
        </button>
        <language-switcher
          locale="{{ lang }}"
          button-label="{{ pageData.nav.languageMenu }}"
          menu-label="{{ pageData.nav.languageLabel }}"
          icon-src="/images/language-switch-white.svg">
          {% for locale in i18n.locales %}
            <a data-locale="{{ locale }}" {% if locale == lang %}aria-current="page"{% endif %} href="/{{ locale }}/">{{ i18n.languageNames[locale] }}</a>
          {% endfor %}
        </language-switcher>
        <appearance-mode
          light-label="{{ pageData.theme.light }}"
          dark-label="{{ pageData.theme.dark }}"
          light-icon-src="/images/theme-light-white-mathjslab.svg"
          dark-icon-src="/images/theme-dark-white-mathjslab.svg"></appearance-mode>
        <div class="header-buttons">
          <a class="button button-small" href="https://app.mathjslab.com/" target="_blank" rel="noopener noreferrer">
            <span class="application-label-full">{{ pageData.nav.launchShort }}</span><span class="application-label-compact">App</span>
          </a>
          <a class="button button-small" href="https://calc.mathjslab.com/" target="_blank" rel="noopener noreferrer">
            <span class="application-label-full">{{ pageData.nav.launchCalcShort }}</span><span class="application-label-compact">Calc</span>
          </a>
        </div>
      </div>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>{% if pageData.footer.copyrightHtml %}{{ pageData.footer.copyrightHtml | safe }}{% else %}{{ pageData.footer.copyright }}{% endif %}</p>
    </footer>
    <script>
      (() => {
        const mobileBreakpoint = 900;
        const toggle = document.querySelector('.menu-toggle');
        const menu = document.querySelector('#site-menu');
        if (toggle && menu) {
          const closeMenu = () => {
            toggle.setAttribute('aria-expanded', 'false');
            menu.removeAttribute('data-open');
          };
          toggle.addEventListener('click', () => {
            const shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';
            toggle.setAttribute('aria-expanded', String(shouldOpen));
            menu.toggleAttribute('data-open', shouldOpen);
          });
          menu.addEventListener('click', (event) => {
            if (window.innerWidth <= mobileBreakpoint && event.target.closest('a')) {
              closeMenu();
            }
          });
          document.addEventListener('click', (event) => {
            if (window.innerWidth > mobileBreakpoint || event.target.closest('.site-header')) {
              return;
            }
            closeMenu();
          });
          window.addEventListener('resize', () => {
            if (window.innerWidth > mobileBreakpoint) {
              closeMenu();
            }
          });
        }
        document.querySelectorAll('[data-pipeline-carousel]').forEach((carousel) => {
          const openButton = carousel.querySelector('.pipeline-carousel-open');
          const overlay = carousel.querySelector('.pipeline-carousel-overlay');
          const images = [...carousel.querySelectorAll('.pipeline-carousel-image')];
          const indicators = [...carousel.querySelectorAll('.pipeline-carousel-indicators span')];
          let currentIndex = 0;
          let touchStartX = 0;
          if (!openButton || !overlay || images.length === 0) {
            return;
          }
          const showPanel = (index) => {
            currentIndex = index;
            images.forEach((image, imageIndex) => {
              image.classList.toggle('is-active', imageIndex === currentIndex);
            });
            indicators.forEach((indicator, indicatorIndex) => {
              indicator.classList.toggle('is-active', indicatorIndex === currentIndex);
            });
          };
          const closeCarousel = () => {
            overlay.removeAttribute('data-open');
            overlay.setAttribute('aria-hidden', 'true');
          };
          const openCarousel = () => {
            showPanel(0);
            overlay.setAttribute('data-open', '');
            overlay.setAttribute('aria-hidden', 'false');
          };
          const advanceCarousel = () => {
            if (currentIndex >= images.length - 1) {
              closeCarousel();
              return;
            }
            showPanel(currentIndex + 1);
          };
          openButton.addEventListener('click', openCarousel);
          overlay.addEventListener('click', (event) => {
            if (event.target === overlay) {
              closeCarousel();
            }
          });
          overlay.addEventListener('touchstart', (event) => {
            touchStartX = event.changedTouches[0].clientX;
          }, { passive: true });
          overlay.addEventListener('touchend', (event) => {
            const touchEndX = event.changedTouches[0].clientX;
            if (touchStartX - touchEndX > 30) {
              advanceCarousel();
            }
          }, { passive: true });
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && overlay.hasAttribute('data-open')) {
              closeCarousel();
            }
          });
        });
      })();
    </script>
  </body>
</html>
