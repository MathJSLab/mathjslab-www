{% set pageData = i18n.pages[lang] %}
<!DOCTYPE html>
<html lang="{{ pageData.htmlLang }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ pageData.title }}</title>
    <meta name="description" content="{{ pageData.description }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ pageData.title }}">
    <meta property="og:description" content="{{ pageData.description }}">
    <meta property="og:url" content="{{ site.url }}/{{ lang }}/">
    <meta property="og:site_name" content="MathJSLab">
    <meta property="og:locale" content="{{ pageData.ogLocale }}">
    {% for locale in i18n.locales %}
      {% if locale != lang %}
        <meta property="og:locale:alternate" content="{{ i18n.pages[locale].ogLocale }}">
      {% endif %}
    {% endfor %}
    <meta property="og:image" content="{{ site.url }}/img/mathjslab-logo.svg">
    <meta property="og:image:width" content="630">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageData.title }}">
    <meta name="twitter:description" content="{{ pageData.description }}">
    <meta name="twitter:image" content="{{ site.url }}/img/mathjslab-logo.svg">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebPage",
            "@id": "{{ site.url }}/{{ lang }}/#webpage",
            "url": "{{ site.url }}/{{ lang }}/",
            "name": "{{ pageData.title }}",
            "description": "{{ pageData.description }}",
            "inLanguage": "{{ pageData.htmlLang }}",
            "isPartOf": {
              "@id": "{{ site.url }}/#website"
            },
            "about": {
              "@id": "{{ site.url }}/#software"
            }
          },
          {
            "@type": "WebSite",
            "@id": "{{ site.url }}/#website",
            "url": "{{ site.url }}/",
            "name": "MathJSLab",
            "publisher": {
              "@id": "{{ site.url }}/#organization"
            }
          },
          {
            "@type": "SoftwareApplication",
            "@id": "{{ site.url }}/#software",
            "name": "MathJSLab",
            "url": "{{ site.url }}/{{ lang }}/",
            "description": "{{ pageData.description }}",
            "applicationCategory": "EducationalApplication",
            "operatingSystem": "Web",
            "inLanguage": "{{ pageData.htmlLang }}",
            "license": "https://opensource.org/license/MIT",
            "author": {
              "@id": "{{ site.url }}/#author"
            },
            "publisher": {
              "@id": "{{ site.url }}/#organization"
            }
          },
          {
            "@type": "Person",
            "@id": "{{ site.url }}/#author",
            "name": "Sergio Lindau"
          },
          {
            "@type": "Organization",
            "@id": "{{ site.url }}/#organization",
            "name": "MathJSLab",
            "url": "{{ site.url }}/",
            "logo": {
              "@type": "ImageObject",
              "url": "{{ site.url }}/img/mathjslab-logo.svg",
              "width": 630,
              "height": 630
            },
            "sameAs": [
              "https://github.com/MathJSLab"
            ]
          }
        ]
      }
    </script>
    <link rel="canonical" href="{{ site.url }}/{{ lang }}/">
    {% for locale in i18n.locales %}
      <link rel="alternate" hreflang="{{ i18n.pages[locale].htmlLang }}" href="{{ site.url }}/{{ locale }}/">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}/en/">
    <link rel="icon" href="/img/favicon.ico">
    <link rel="stylesheet" href="/css/main.css">
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/{{ lang }}/" aria-label="MathJSLab">
        <img src="/img/mathjslab-logo.svg" alt="" width="121" height="121">
        <span><strong>MathJSLab</strong></span>
      </a>
      <div id="site-menu" class="site-menu">
        <nav class="main-nav" aria-label="{{ pageData.nav.mainNavLabel }}">
          <a href="#overview">{{ pageData.nav.overview }}</a>
          <a href="#pipeline">{{ pageData.nav.pipeline }}</a>
          <a href="#features">{{ pageData.nav.features }}</a>
          <a href="#ecosystem">{{ pageData.nav.ecosystem }}</a>
          <a href="#publication">{{ pageData.nav.publication }}</a>
          <a href="#archive">{{ pageData.nav.archive }}</a>
          <a href="#resources">{{ pageData.nav.resources }}</a>
          <a href="#contact">{{ pageData.nav.contact }}</a>
          <a href="#license">{{ pageData.nav.license }}</a>
        </nav>
      </div>
      <div class="header-actions">
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
          <span class="menu-toggle-icon" aria-hidden="true"></span>
          <span>{{ pageData.nav.menu }}</span>
        </button>
        <button class="language-toggle" type="button" aria-expanded="false" aria-controls="language-menu">
          <img class="language-toggle-icon" src="/img/language-switch.svg" alt="" aria-hidden="true">
          <span>{{ pageData.nav.languageMenu }}</span>
        </button>
        <ul id="language-menu" class="language-switcher" aria-label="{{ pageData.nav.languageLabel }}">
          {% for locale in i18n.locales %}
            <li>
              <a {% if locale == lang %}aria-current="page"{% endif %} href="/{{ locale }}/">{{ i18n.languageNames[locale] }}</a>
            </li>
          {% endfor %}
        </ul>
        <div class="header-buttons">
          <a class="button button-small" href="/{{ lang }}/app/" target="_blank" rel="noopener noreferrer">
            <span class="button-label-full">{{ pageData.nav.launch }}</span>
            <span class="button-label-short">{{ pageData.nav.launchShort }}</span>
          </a>
        </div>
      </div>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>{% if pageData.footer.copyrightHtml %}{{ pageData.footer.copyrightHtml | safe }}{% else %}{{ pageData.footer.copyright }}{% endif %}</p>
    </footer>
    <script>
      (() => {
        const mobileBreakpoint = 900;
        const toggle = document.querySelector('.menu-toggle');
        const menu = document.querySelector('#site-menu');
        const languageToggle = document.querySelector('.language-toggle');
        const languageMenu = document.querySelector('#language-menu');
        if (!toggle || !menu || !languageToggle || !languageMenu) {
          return;
        }
        const closeMenu = () => {
          toggle.setAttribute('aria-expanded', 'false');
          menu.removeAttribute('data-open');
        };
        const closeLanguageMenu = () => {
          languageToggle.setAttribute('aria-expanded', 'false');
          languageMenu.removeAttribute('data-open');
        };
        toggle.addEventListener('click', () => {
          const shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';
          toggle.setAttribute('aria-expanded', String(shouldOpen));
          menu.toggleAttribute('data-open', shouldOpen);
          closeLanguageMenu();
        });
        languageToggle.addEventListener('click', () => {
          const shouldOpen = languageToggle.getAttribute('aria-expanded') !== 'true';
          languageToggle.setAttribute('aria-expanded', String(shouldOpen));
          languageMenu.toggleAttribute('data-open', shouldOpen);
          closeMenu();
        });
        menu.addEventListener('click', (event) => {
          if (window.innerWidth <= mobileBreakpoint && event.target.closest('a')) {
            closeMenu();
          }
        });
        languageMenu.addEventListener('click', (event) => {
          if (window.innerWidth <= mobileBreakpoint && event.target.closest('a')) {
            closeLanguageMenu();
          }
        });
        document.addEventListener('click', (event) => {
          if (window.innerWidth > mobileBreakpoint || event.target.closest('.site-header')) {
            return;
          }
          closeMenu();
          closeLanguageMenu();
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth > mobileBreakpoint) {
            closeMenu();
            closeLanguageMenu();
          }
        });
        document.querySelectorAll('[data-pipeline-carousel]').forEach((carousel) => {
          const openButton = carousel.querySelector('.pipeline-carousel-open');
          const overlay = carousel.querySelector('.pipeline-carousel-overlay');
          const images = [...carousel.querySelectorAll('.pipeline-carousel-image')];
          const indicators = [...carousel.querySelectorAll('.pipeline-carousel-indicators span')];
          let currentIndex = 0;
          let touchStartX = 0;
          if (!openButton || !overlay || images.length === 0) {
            return;
          }
          const showPanel = (index) => {
            currentIndex = index;
            images.forEach((image, imageIndex) => {
              image.classList.toggle('is-active', imageIndex === currentIndex);
            });
            indicators.forEach((indicator, indicatorIndex) => {
              indicator.classList.toggle('is-active', indicatorIndex === currentIndex);
            });
          };
          const closeCarousel = () => {
            overlay.removeAttribute('data-open');
            overlay.setAttribute('aria-hidden', 'true');
          };
          const openCarousel = () => {
            showPanel(0);
            overlay.setAttribute('data-open', '');
            overlay.setAttribute('aria-hidden', 'false');
          };
          const advanceCarousel = () => {
            if (currentIndex >= images.length - 1) {
              closeCarousel();
              return;
            }
            showPanel(currentIndex + 1);
          };
          openButton.addEventListener('click', openCarousel);
          overlay.addEventListener('click', (event) => {
            if (event.target === overlay) {
              closeCarousel();
            }
          });
          overlay.addEventListener('touchstart', (event) => {
            touchStartX = event.changedTouches[0].clientX;
          }, { passive: true });
          overlay.addEventListener('touchend', (event) => {
            const touchEndX = event.changedTouches[0].clientX;
            if (touchStartX - touchEndX > 30) {
              advanceCarousel();
            }
          }, { passive: true });
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && overlay.hasAttribute('data-open')) {
              closeCarousel();
            }
          });
        });
      })();
    </script>
  </body>
</html>
